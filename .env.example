# LLM Configuration
# Option 1: LiteLLM Proxy (recommended for production)
LLM_BASE_URL=https://licenses.maxawad.com/v1
LLM_API_KEY=your-litellm-key-here
LLM_CHAT_MODEL=gpt-5
LLM_FAST_MODEL=fast

# Option 2: Direct OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-openai-key
# LLM_CHAT_MODEL=gpt-4o
# LLM_FAST_MODEL=gpt-4o-mini

# If no LLM_API_KEY is set, the app runs in mock mode with pre-built responses.

# Server
PORT=3000
HOST=0.0.0.0

# RAG Configuration
RAG_TOP_K=4          # Number of FAQ entries retrieved per query (default: 4)
MEMORY_TOP_K=3       # Number of relevant memories injected per query (default: 3)
