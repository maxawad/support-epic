# Copy to .env and fill in. Never commit .env.

# Leave LLM_API_KEY empty to run in mock mode (no live model).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=gpt-4o
LLM_FAST_MODEL=gpt-4o-mini

PORT=3000
HOST=0.0.0.0

# FAQ entries retrieved per query
RAG_TOP_K=4
# Relevant memories injected per query
MEMORY_TOP_K=3

# Code explorer session length in ms (7200000 = 2 hours)
EDIT_DURATION_MS=7200000
